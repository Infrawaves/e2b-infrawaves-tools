          "id": 421,
          "options": {
            "cellHeight": "sm",
            "footer": {
              "show": false
            },
            "showHeader": true
          },
          "pluginVersion": "",
          "targets": [
            {
              "datasource": {
                "type": "postgres",
                "uid": "${DS_POSTGRES_ENVS}"
              },
              "format": "table",
              "rawQuery": true,
              "rawSql": "WITH resolved AS (SELECT COALESCE((SELECT env_id FROM env_aliases WHERE alias = '${tpl}' LIMIT 1),(SELECT id FROM envs WHERE id = '${tpl}' LIMIT 1)) AS env_id)\nSELECT e.id AS \"模板ID\", string_agg(DISTINCT a.alias, ', ') AS \"别名\",\n e.public AS \"是否公开\", t.name AS \"团队\", e.team_id AS \"团队ID\",\n e.build_count AS \"构建次数\", e.spawn_count AS \"启动次数\",\n e.last_spawned_at AS \"最后启动\", e.source AS \"来源\",\n e.created_at AS \"创建时间\", e.updated_at AS \"更新时间\", e.deleted_at AS \"删除时间\",\n e.created_by AS \"创建人ID\", e.cluster_id AS \"集群ID\", d.description AS \"描述\"\nFROM envs e\nJOIN resolved r ON e.id = r.env_id\nLEFT JOIN env_aliases a ON a.env_id = e.id\nLEFT JOIN teams t ON t.id = e.team_id\nLEFT JOIN env_defaults d ON d.env_id = e.id\nGROUP BY e.id, e.public, t.name, e.team_id, e.build_count, e.spawn_count,\n e.last_spawned_at, e.source, e.created_at, e.updated_at, e.deleted_at,\n e.created_by, e.cluster_id, d.description",
              "refId": "A"
            }
          ],
          "title": "模板概览(主表 / 团队 / 别名 / 描述)",
          "type": "table"
        },
        {
          "datasource": {
            "type": "postgres",
            "uid": "${DS_POSTGRES_ENVS}"
