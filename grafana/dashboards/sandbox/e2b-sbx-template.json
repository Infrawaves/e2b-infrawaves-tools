              "format": "table",
              "rawQuery": true,
              "rawSql": "WITH resolved AS (SELECT COALESCE((SELECT env_id FROM env_aliases WHERE alias = '${tpl}' LIMIT 1),(SELECT id FROM envs WHERE id = '${tpl}' LIMIT 1)) AS env_id)\nSELECT a.alias AS \"别名\", a.namespace AS \"命名空间\",\n a.is_renamable AS \"可改名\", a.id AS \"别名ID\"\nFROM env_aliases a JOIN resolved r ON a.env_id = r.env_id\nORDER BY a.alias",
