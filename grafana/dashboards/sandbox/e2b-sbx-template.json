              "format": "table",
              "rawQuery": true,
              "rawSql": "WITH resolved AS (SELECT COALESCE((SELECT env_id FROM env_aliases WHERE alias = '${tpl}' LIMIT 1),(SELECT id FROM envs WHERE id = '${tpl}' LIMIT 1)) AS env_id)\nSELECT s.created_at AS \"快照时间\", s.sandbox_id AS \"沙箱ID\",\n s.base_env_id AS \"基础模板\", s.origin_node_id AS \"来源节点\",\n s.sandbox_started_at AS \"沙箱启动\", s.auto_pause AS \"自动暂停\",\n s.allow_internet_access AS \"允许联网\", s.env_secure AS \"安全环境\",\n s.metadata AS \"元数据\", s.id AS \"快照ID\"\nFROM snapshots s JOIN resolved r ON s.env_id = r.env_id\nORDER BY s.created_at DESC LIMIT 100",
              "refId": "A"
            }
          ],
          "title": "最近快照 / 沙箱(最多100条)",
          "type": "table"
        }
