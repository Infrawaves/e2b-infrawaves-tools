              "show": false
            },
            "showHeader": true
          },
          "pluginVersion": "",
          "targets": [
            {
              "datasource": {
                "type": "postgres",
                "uid": "${DS_POSTGRES_ENVS}"
              },
              "format": "table",
              "rawQuery": true,
              "rawSql": "WITH resolved AS (SELECT COALESCE((SELECT env_id FROM env_aliases WHERE alias = '${tpl}' LIMIT 1),(SELECT id FROM envs WHERE id = '${tpl}' LIMIT 1)) AS env_id)\nSELECT b.created_at AS \"构建时间\", b.finished_at AS \"完成时间\",\n b.status AS \"状态\", b.status_group AS \"状态组\", b.version AS \"版本\",\n b.vcpu AS \"vCPU\", b.ram_mb AS \"内存MB\",\n b.total_disk_size_mb AS \"总磁盘MB\", b.free_disk_size_mb AS \"空闲磁盘MB\",\n b.kernel_version AS \"内核\", b.firecracker_version AS \"FC版本\", b.envd_version AS \"envd版本\",\n b.cpu_architecture AS \"CPU架构\", b.cpu_model_name AS \"CPU型号\",\n b.cluster_node_id AS \"构建节点\", b.start_cmd AS \"启动命令\", b.ready_cmd AS \"就绪命令\",\n b.reason->>'message' AS \"原因\", b.id AS \"构建ID\"\nFROM env_builds b JOIN resolved r ON b.env_id = r.env_id\nORDER BY b.created_at DESC",
              "refId": "A"
            }
          ],
          "title": "构建历史(版本 / 资源 / 状态 / CPU / 节点)",
          "type": "table"
        },
