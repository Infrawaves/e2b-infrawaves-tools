        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "(up{job=\"ecs\"} == 0) * on(instance) group_left(node_name, node_id, role) last_over_time(nomad_node_role[15m])",
          "format": "table",
          "instant": true,
          "refId": "A"
        }
      ],
      "title": "Exporter 离线节点（up=0）",
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Value": true,
              "__name__": true,
              "job": true,
              "prometheus": true
            },
            "indexByName": {
              "instance": 0,
              "node_id": 2,
              "node_name": 1,
              "role": 3
            },
            "renameByName": {
              "instance": "离线节点 (ip:端口)",
              "node_id": "nomad_id (node_id)",
              "node_name": "节点名 (node_name)",
              "role": "角色 (role)"
            }
          }
        }
      ],
      "type": "table"
    },
