      "description": "job=ecs 的 exporter(9106) 探活失败(up=0)的节点。为空=全部在线。已关联节点名(node_name)、nomad_id(node_id)、角色(role)。",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "left",
