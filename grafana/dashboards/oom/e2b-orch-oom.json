        "showPercentChange": false,
        "textMode": "auto",
        "wideLayout": true
      },
      "pluginVersion": "13.0.1+security-01",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "max by(node_ip)(e2b_orchestrator_oom_recovered{node_ip=~\"$node\"})",
          "legendFormat": "{{node_ip}}",
          "refId": "A"
