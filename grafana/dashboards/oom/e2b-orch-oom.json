      "description": "布尔值：上一刻正常、随后 orchestrator 被 OOM 拉起，则该节点在恢复观察期(默认5分钟)内显示 1(红)，之后回落到 0(绿)。用来一眼看出\"现在刚发生过 OOM\"。",
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "options": {
                "0": {
                  "color": "green",
                  "text": "正常"
                },
                "1": {
                  "color": "red",
                  "text": "OOM 恢复观察期"
                }
              },
              "type": "value"
            }
          ],
          "noValue": "正常",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": 0
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "unit": "short"
        }
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 1
